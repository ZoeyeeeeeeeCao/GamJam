MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 108865588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d32fda936a5416742acb896c7c355f20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: S.M.T.
  npcPortrait: {fileID: 21300000, guid: 89ea9c07a371dee4a97fc0a9cb60fe7c, type: 3}
  lines:
  - isPlayer: 0
    text: "Hey. You\u2019re the new hire, right?"
  - isPlayer: 1
    text: "Uh\u2026 yes."
  - isPlayer: 0
    text: 'See that pile of food in the back?

      Go move it into the kitchen.'
  - isPlayer: 1
    text: "Wait\u2014 what?\nThose have ... already gone bad.\nWe can\u2019t serve
      that, can we?"
  - isPlayer: 0
    text: "That\u2019s why I\u2019m telling you to take it to the kitchen, not put
      it on display!"
  - isPlayer: 0
    text: "Relax. A little \u201Cspecial mix\u201D will fix everything.\nNo one\u2019s
      gonna notice a thing."
  - isPlayer: 0
    text: "I\u2019ll teach you the recipe later, so pay attention\u2014\nmess it
      up, and the thing that ends up \u201Cgoing bad\u201D\u2026\nwon\u2019t be the
      food."
  - isPlayer: 1
    text: "\u2026Sorry, what exactly is supposed to \u201Cgo bad\u201D?"
  - isPlayer: 0
    text: 'The customers, obviously.

      Who else?'
  - isPlayer: 1
    text: ...
  - isPlayer: 0
    text: "Anyway\u2014 get your ass up\nTime to learn how things work around here."
  triggerOnlyOnce: 1
